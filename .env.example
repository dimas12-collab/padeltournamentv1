# Local development uses the PostgreSQL service in docker-compose.yml.
DATABASE_URL=postgresql://padel:padel_local_password@localhost:5432/padel_battle
BETTER_AUTH_URL=http://localhost:3000
# Generate a unique production value: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
